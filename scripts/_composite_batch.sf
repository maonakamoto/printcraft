; Auto-generated GIMP composite script
; Canvas: 5900x5700

(let* (
  (canvas (car (gimp-image-new 5900 5700 RGB)))
  (bg-layer (car (gimp-layer-new canvas 5900 5700 RGBA-IMAGE "Background" 100 LAYER-MODE-NORMAL)))
  )
  (gimp-image-insert-layer canvas bg-layer 0 -1)
  ; Sunset gradient background
  (gimp-context-set-foreground '(255 160 60))
  (gimp-context-set-background '(20 40 80))
  (gimp-drawable-edit-fill bg-layer FILL-FOREGROUND)
  (gimp-context-set-opacity 100)
  (gimp-gradient-select "FG to BG (RGB)")
  (gimp-drawable-edit-gradient-fill bg-layer GRADIENT-LINEAR 0 REPEAT-NONE 0 FALSE 0 0 TRUE 0 0 0 5700)

  ; --- bild7_vw ---
  (let* (
    (scene-layer (car (gimp-file-load-layer RUN-NONINTERACTIVE canvas "/home/g/Dokumente/Duschwand/07-grok-v4-retro-poster/bild7_vw_van.jpg")))
    )
    (gimp-image-insert-layer canvas scene-layer 0 -1)
    (gimp-layer-set-name scene-layer "bild7_vw")
    (let* (
      (orig-w (car (gimp-drawable-get-width scene-layer)))
      (orig-h (car (gimp-drawable-get-height scene-layer)))
      (scale-factor (/ 750.0 orig-w))
      (new-h (inexact->exact (round (* orig-h scale-factor))))
      )
      (gimp-layer-scale scene-layer 750 new-h FALSE)
      (let* (
        (pos-x (- 1600 (/ 750 2)))
        (pos-y (- 2700 new-h))
        )
        (gimp-layer-set-offsets scene-layer pos-x pos-y)
        (gimp-drawable-desaturate scene-layer DESATURATE-AVERAGE)
        (gimp-drawable-color-balance scene-layer COLOR-RANGE-MIDTONES TRUE -10 0 -20)
        (gimp-layer-set-opacity scene-layer 75)
        (plug-in-gauss RUN-NONINTERACTIVE canvas scene-layer 3 3 0)
        (let* (
          (mask (car (gimp-layer-create-mask scene-layer ADD-MASK-WHITE)))
          )
          (gimp-layer-add-mask scene-layer mask)
          ; Gradient on mask: fade bottom 20% to transparent
          (gimp-context-set-foreground '(255 255 255))
          (gimp-context-set-background '(0 0 0))
          (let* (
            (layer-h (car (gimp-drawable-get-height scene-layer)))
            (layer-offY (car (cdr (gimp-drawable-get-offsets scene-layer))))
            (fade-start (+ layer-offY (inexact->exact (round (* layer-h 0.8)))))
            (fade-end (+ layer-offY layer-h))
            )
            (gimp-drawable-edit-gradient-fill mask GRADIENT-LINEAR 0 REPEAT-NONE 0 FALSE 0 0 TRUE 0 fade-start 0 fade-end)
          )
        )
      )
    )
  )

